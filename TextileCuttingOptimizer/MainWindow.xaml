    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Панель управления -->
        <StackPanel Grid.Column="0" Margin="10">
            <GroupBox Header="Ткань">
                <ComboBox ItemsSource="{Binding Fabrics}" 
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedFabric}"/>
            </GroupBox>

            <GroupBox Header="Наволочки" Margin="0,10">
                <StackPanel>
                    <ComboBox ItemsSource="{Binding PillowcaseSizes}"
                              SelectedItem="{Binding SelectedPillowcaseSize}"/>
                    <TextBox Text="{Binding PillowcaseCount}" Margin="0,5" 
                             ToolTip="Количество"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Пододеяльник" Margin="0,10">
                <StackPanel>
                    <ComboBox ItemsSource="{Binding DuvetCoverSizes}"
                              SelectedItem="{Binding SelectedDuvetCoverSize}"/>
                    <TextBox Text="{Binding DuvetCoverCount}" Margin="0,5"
                             ToolTip="Количество"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Простыня" Margin="0,10">
                <TextBox Text="{Binding SheetCount}" 
                         ToolTip="Количество"/>
            </GroupBox>

            <Button Content="Рассчитать" Margin="0,20" Height="30"
                    Click="Calculate_Click"/>
        </StackPanel>

        <!-- Визуализация -->
        <Canvas x:Name="CuttingCanvas" Grid.Column="1" Background="White"/>
    </Grid>
</Window>
